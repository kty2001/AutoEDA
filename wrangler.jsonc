{
  // Cloudflare Workers 정적 자산 배포 설정.
  // 이 파일이 없으면 배포마다 임시 config가 생성되어 배포가 막힌다(형제 프로젝트 2026-07-08 실제 장애).
  // name 은 배포 후 워커 이름과 일치해야 한다 (URL: autoeda.tyoujungzz.workers.dev).
  "name": "autoeda",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./",
    // 없는 경로에서 스타일된 404.html 을 서빙한다.
    "not_found_handling": "404-page"
    // html_handling 은 기본값(auto-trailing-slash)을 유지한다.
    // 기본값은 /pages/about.html 요청을 /pages/about 으로 307 리디렉션하므로
    // 내부 링크·canonical·sitemap 을 모두 "확장자 없는 URL"로 통일해야 한다.
    // "none" 으로 끄면 확장자 없는 URL 이 404 가 되므로 해법이 아니다.
    // → docs/tech-stack.md §6
  }
}
