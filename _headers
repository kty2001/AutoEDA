# Cloudflare 정적 자산 응답 헤더 (Pages/Workers Assets 공용 형식)
#
# CSP 는 엄격하게 유지한다 — 외부 라이브러리를 쓰지 않고 전부 자체 구현이므로
# script-src 에 예외를 열 이유가 없다('unsafe-inline'/'unsafe-eval' 없음).
#
# ⚠️ style-src 'self' 이므로 인라인 style= 속성이 차단된다.
#    자체 SVG 차트는 fill / stroke / stroke-width 같은 presentation attribute 와
#    class 만 사용하고 인라인 style 을 쓰지 않는다. SVG 에서는 이것으로 충분하다.
#    → docs/tech-stack.md §6
#
# ⚠️ AdSense 를 도입하면 script-src / frame-src / img-src / connect-src 에
#    광고 도메인을 추가해야 한다. 광고를 실제로 붙이기 전까지는 열지 않는다.
#    필요해지면 ../weareants/_headers 의 도메인 목록을 참조한다.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'none'
